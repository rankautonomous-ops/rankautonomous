# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rankautonomous

# Authentication (Managed Auth Solution - e.g., Supabase / Clerk / Auth0)
AUTH_SECRET=your_auth_secret_here
AUTH_CLIENT_ID=your_auth_client_id_here
AUTH_ISSUER_URL=your_auth_issuer_url_here

# AI Provider (e.g., OpenAI, Anthropic)
AI_PROVIDER_API_KEY=your_ai_api_key_here
AI_MODEL_PREFERENCE=gpt-4o

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# SEO & Analytics Integrations
SEARCH_CONSOLE_CLIENT_EMAIL=your_gcp_service_account_email
SEARCH_CONSOLE_PRIVATE_KEY=your_gcp_private_key
GOOGLE_ANALYTICS_PROPERTY_ID=your_ga4_property_id

# CMS Publishing
CMS_DEFAULT_TIMEOUT_MS=10000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
