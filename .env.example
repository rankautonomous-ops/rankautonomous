# Database (Supabase PostgreSQL Session Pooler & Direct URL)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Authentication (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# AI Provider (Google Gemini, OpenAI, etc.)
# Option A: Google Gemini (Recommended — fast and cost-effective)
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=AIzaSy_your_gemini_api_key_here
AI_MODEL_PREFERENCE=gemini-2.0-flash
# (Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)

# Option B: OpenAI (Alternative)
# AI_PROVIDER=openai
# AI_PROVIDER_API_KEY=sk_your_openai_api_key_here
# AI_MODEL_PREFERENCE=gpt-4o

# Payment (Stripe Server-Side Configuration)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_APP_URL=http://localhost:3000

# SEO & Analytics Integrations
SEARCH_CONSOLE_CLIENT_EMAIL=your_gcp_service_account_email
SEARCH_CONSOLE_PRIVATE_KEY=your_gcp_private_key
GOOGLE_ANALYTICS_PROPERTY_ID=your_ga4_property_id

# CMS Publishing
CMS_DEFAULT_TIMEOUT_MS=10000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
