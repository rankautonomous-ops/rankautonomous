datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum WebsiteStatus {
  CONNECTED
  ANALYZING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum SeoIssuePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum ArticleStatus {
  IDEA
  DRAFT
  AI_REVIEW
  USER_REVIEW
  APPROVED
  PUBLISHED
}

enum BacklinkOpportunityType {
  GUEST_POST
  RELEVANT_WEBSITE
  RESOURCE_PAGE
  BUSINESS_DIRECTORY
  INDUSTRY_PUBLICATION
  BRAND_MENTION
  BROKEN_LINK
  PARTNERSHIP
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CrawlStatus {
  PENDING
  CRAWLING
  COMPLETED
  FAILED
  CANCELLED
}

enum KeywordStatus {
  ACTIVE
  ARCHIVED
}

enum KeywordSource {
  USER_ENTERED
  AI_SUGGESTED
  EXTERNAL_PROVIDER
  SEARCH_CONSOLE
}

enum OpportunityStatus {
  DISCOVERED
  QUALIFIED
  READY
  CONTACTED
  REPLIED
  ACCEPTED
  LINK_ACQUIRED
  REJECTED
}

enum BacklinkVerificationStatus {
  UNVERIFIED
  VERIFIED
  MISSING
  ERROR
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  supabaseAuthId String?  @unique
  email          String   @unique
  name           String?
  role           Role     @default(CUSTOMER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  subscriptions  Subscription[]
  websites       Website[]
  aiJobs         AiJob[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String   // e.g., "monthly", "annual"
  interval             String   // e.g., "month", "year"
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  status               String   // e.g., "active", "past_due", "canceled"
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Website {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url            String
  name           String
  platform       String?       // e.g., "WordPress", "Shopify"
  industry       String?
  targetCountry  String?
  targetAudience String?
  primaryKeywords String[]     // Array of strings or just text representation
  status         WebsiteStatus @default(CONNECTED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Additive onboarding fields
  description        String?
  seoGoals           String[]      @default([])
  targetLocationType String?       @default("GLOBAL")
  targetRegion       String?
  targetCity         String?

  // Relationships
  seoAudits             SeoAudit[]
  seoStrategies         SeoStrategy[]
  seoIssues             SeoIssue[]
  keywords              Keyword[]
  articles              Article[]
  backlinkOpportunities BacklinkOpportunity[]
  backlinks             Backlink[]
  integrations          Integration[]
  analyticsSnapshots    AnalyticsSnapshot[]
  crawlJobs             CrawlJob[]
  searchPerformanceRecords SearchPerformanceRecord[]

  @@index([userId])
}

model SeoAudit {
  id          String   @id @default(uuid())
  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawlJobId  String
  crawlJob    CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  healthScore Float?   // e.g., 78.5
  status      String   // e.g., "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  summaryData Json?    // Raw summary of scores by category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  seoIssues     SeoIssue[]
  seoStrategies SeoStrategy[]

  @@index([websiteId])
  @@index([crawlJobId])
}

model SeoStrategy {
  id            String   @id @default(uuid())
  websiteId     String
  website       Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawlJobId    String
  crawlJob      CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  seoAuditId    String
  seoAudit      SeoAudit @relation(fields: [seoAuditId], references: [id], onDelete: Cascade)
  status        String   // PENDING, PROCESSING, COMPLETED, FAILED
  summary       String?  @db.Text
  strategyData  Json?    
  error         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([websiteId])
  @@index([crawlJobId])
  @@index([seoAuditId])
}

model SeoIssue {
  id             String           @id @default(uuid())
  websiteId      String
  website        Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  seoAuditId     String?
  seoAudit       SeoAudit?        @relation(fields: [seoAuditId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String           // e.g., "Technical SEO", "On-page"
  priority       SeoIssuePriority
  impact         String?
  recommendation String?
  status         String           @default("OPEN") // e.g., "OPEN", "FIXED", "IGNORED"
  affectedUrl    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([websiteId])
  @@index([seoAuditId])
}

model Keyword {
  id               String       @id @default(uuid())
  websiteId        String
  website          Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          String
  normalizedKeyword String
  searchVolume     Int?
  difficulty       Float?
  intent           SearchIntent?
  currentRanking   Int?
  targetUrl        String?
  opportunityScore Float?
  cluster          String?
  source           KeywordSource?
  status           KeywordStatus @default(ACTIVE)
  gscClicks30d       Int?
  gscImpressions30d  Int?
  gscAvgPosition     Float?
  gscLastUpdated     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([websiteId])
  @@unique([websiteId, normalizedKeyword])
}

model Article {
  id                    String        @id @default(uuid())
  websiteId             String
  website               Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  topic                 String?
  primaryKeyword        String?
  title                 String?
  metaDescription       String?
  slug                  String?
  content               String?       @db.Text
  wordCount             Int?
  tone                  String?
  language              String?
  targetAudience        String?
  targetLocation        String?
  callToAction          String?
  seoData               Json?
  internalLinks         Json?         // Suggestions
  externalReferences    Json?
  status                ArticleStatus @default(IDEA)
  generationJobId       String?
  reviewJobId           String?
  generationMetadata    Json?
  aiReviewData          Json?
  scheduledAt           DateTime?
  publishedAt           DateTime?
  cmsPublicationInfo    Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([websiteId])
  @@index([status])
  @@index([websiteId, status])
}

model BacklinkOpportunity {
  id                 String                  @id @default(uuid())
  websiteId          String
  website            Website                 @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  domain             String
  url                String?
  domainInfo         Json?
  relevance          Float?
  type               BacklinkOpportunityType
  contactInfo        Json?
  suggestedAction    String?
  suggestedAnchor    String?
  domainAuthority    Int?
  campaignId         String?
  status             OpportunityStatus       @default(DISCOVERED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([websiteId])
  @@index([websiteId, status])
  @@index([websiteId, type])
}

model Backlink {
  id               String   @id @default(uuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sourceUrl        String
  targetUrl        String
  referringDomain  String
  anchorText       String?
  status           String   @default("ACTIVE") // ACTIVE, LOST (Maintained for backward compatibility)
  
  // Verification State
  verificationStatus BacklinkVerificationStatus @default(UNVERIFIED)
  linkAttributes     String[]                   @default([])
  lastErrorMessage   String?                    @db.Text
  
  firstDiscovered  DateTime @default(now())
  lastChecked      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([websiteId])
  @@index([websiteId, status])
  @@index([websiteId, verificationStatus])
  @@index([websiteId, lastChecked])
}

model Integration {
  id             String    @id @default(uuid())
  websiteId      String
  website        Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  provider       String    // "WORDPRESS", "GSC", "GOOGLE_ANALYTICS"
  config         Json?     // Non-sensitive connection config: { siteUrl, username, ... }
  credentials    String?   // Encrypted reference or secure token
  status         String    @default("ACTIVE")
  lastSyncAt     DateTime?
  lastSyncStatus String?   // "IDLE", "SYNCING", "SUCCESS", "ERROR"
  lastSyncError  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([websiteId])
  @@unique([websiteId, provider])
}

model AnalyticsSnapshot {
  id               String   @id @default(uuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  source           String   // e.g., "GSC", "GA4", "INTERNAL"
  date             DateTime
  metrics          Json     // { organicTraffic, clicks, impressions, ctr, etc. }
  createdAt        DateTime @default(now())

  @@index([websiteId])
  @@index([websiteId, date])
  @@unique([websiteId, source, date])
}

model SearchPerformanceRecord {
  id          String   @id @default(uuid())
  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date

  query       String
  page        String

  device      String   @default("ALL")
  country     String   @default("ALL")

  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  createdAt   DateTime @default(now())

  @@unique([websiteId, date, query, page, device, country])
  @@index([websiteId, date])
  @@index([websiteId, query])
  @@index([websiteId, page])
}

model AiJob {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteId   String?     // Optional, as some jobs might be account level
  type        String      // e.g., "GENERATE_ARTICLE", "SEO_AUDIT"
  status      AiJobStatus @default(QUEUED)
  payload     Json?
  result      Json?
  error       String?     @db.Text
  retryCount  Int         @default(0)
  scheduledAt DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // e.g., "CONTENT", "BILLING", "SEO_ISSUE"
  title         String
  message       String   @db.Text
  isRead        Boolean  @default(false)
  relatedEntity String?  // e.g., "Article"
  entityId      String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model CrawlJob {
  id          String      @id @default(uuid())
  websiteId   String
  website     Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  status      CrawlStatus @default(PENDING)
  totalUrls   Int         @default(0)
  crawledUrls Int         @default(0)
  failedUrls  Int         @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pages         PageResult[]
  seoAudits     SeoAudit[]
  seoStrategies SeoStrategy[]

  @@index([websiteId])
  @@index([status])
}

model PageResult {
  id            String    @id @default(uuid())
  crawlJobId    String
  crawlJob      CrawlJob  @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  url           String
  normalizedUrl String?
  statusCode    Int?
  status        String?   // SUCCESS, FAILED
  title         String?
  description   String?
  h1            String?
  wordCount     Int?
  htmlSize      Int?
  internalLinks Json?     // Array of strings
  externalLinks Json?     // Array of strings
  error         String?   @db.Text
  canonicalUrl  String?
  depth         Int       @default(0)
  crawledAt     DateTime  @default(now())
  
  @@index([crawlJobId])
  @@unique([crawlJobId, url])
}

model BackgroundJob {
  id          String    @id @default(uuid())
  type        String    // e.g., 'GOOGLE_SYNC', 'SEO_CRAWL'
  payload     Json
  status      String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRunAt   DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([status, nextRunAt])
}
